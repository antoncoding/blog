# Notion page ID (optional - leave empty if only using Obsidian/GitHub)
NOTION_PAGE_ID=

# GitHub repo for fetching posts (optional)
# Example: If your posts are at https://github.com/antoncoding/obsidian-vault/posts
GITHUB_OWNER=antoncoding
GITHUB_REPO=obsidian-vault
GITHUB_PATH=posts

# GitHub token (optional, for private repos or to increase API rate limit)
# Get one at https://github.com/settings/tokens
GITHUB_TOKEN=